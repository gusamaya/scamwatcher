# Copy to .env for local testing. In production, set these in your host's
# environment settings instead of committing a file.

# --- Dashboard login ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Mailbox the inbox worker reads and replies from ---
EMAIL_ADDRESS=check@scamwatcher.com.au
# Google Workspace / Gmail app password (not the normal account password)
EMAIL_PASSWORD=
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# --- Website ---
# Where people are sent back to after using the website form
SITE_URL=https://scamwatcher.com.au

# --- Privacy: must match what the website promises ---
# "Deleted after 30 days". 0 = never delete automatically.
RETENTION_DAYS=0
# A copy of every reply goes here. Leave empty to turn it off.
AUDIT_BCC_EMAIL=scamwatcher.audit@gmail.com

# --- Branding in replies and the dashboard ---
BRAND_NAME=ScamWatcher
BRAND_TAGLINE=Helping people stay safe in a digital world
ADVISOR_NAME=Serena
ADVISOR_TITLE=ScamWatcher Advisor
REFERENCE_PREFIX=SW

# --- Storage ---
DB_PATH=/var/data/scamwatcher.db
# UPLOAD_DIR defaults to an "uploads" folder next to the database
MAX_UPLOAD_MB=10
# Screenshots allowed per website submission
MAX_SCREENSHOTS=5

# --- Automatic screenshot review (Claude) ---
# Without a key, screenshots wait for a manual review.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
AUTO_REVIEW_ENABLED=true

# --- Behaviour ---
# true: replies go out automatically for forwarded emails, and for screenshots
# the automatic review read with HIGH confidence. Direct emails, notes-only
# form submissions, and medium/low-confidence or failed screenshot reviews
# always wait for "Approve and send".
AUTO_SEND_ENABLED=false
# Set false to send every screenshot reply by hand.
AUTO_SEND_SCREENSHOTS=true
# UTC "YYYY-MM-DD HH:MM:SS": only reply automatically to submissions received
# from this time on, so old drafts and tests are never mailed.
AUTO_SEND_AFTER=
INBOX_WORKER_ENABLED=true
# Website form submissions allowed per address per hour
INTAKE_RATE_LIMIT=5

# --- Reply wording (Australian defaults) ---
REPLY_GREETING=Hi there,
REPLY_SIGNOFF=Regards,
MONEY_CONTACT=your bank
DEFAULT_COUNTRY=Australia
REVIEW_AUDIENCE=australia
EMAIL_ACCENT=#D9A93A
EMAIL_DARK=#0f2d5c
